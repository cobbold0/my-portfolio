# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTENT_SOURCE=sanity

# Contact form
CONTACT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GitHub integration (optional, required for private repo counts + contributions + commit activity)
