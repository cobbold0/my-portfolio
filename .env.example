NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_ANALYTICS_IN_DEV=false
NEXT_PUBLIC_FIREBASE_ANALYTICS_DEBUG=false

# Sanity public env (Next.js + Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-01-01
STUDIO_ACCESS_PIN=

# Sanity server env (Next.js)
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Sanity seed script/admin usage
